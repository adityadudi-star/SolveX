# ---------------- SolveX backend configuration ----------------
# Copy to backend/.env and fill in. NEVER commit .env. Nothing here is ever sent to the frontend.

# REQUIRED for live SEC EDGAR access. The SEC fair-access policy requires a truthful User-Agent
# with a real contact email. SolveX builds:  "SolveX Financial Auditor/1.0.0 (contact: <this email>)"
SEC_CONTACT_EMAIL=

# Demo reviewer protection (shared token). CHANGE IT. This is NOT production-grade authentication.
REVIEWER_TOKEN=change-me-demo-reviewer-token

# ---- Optional LLM (the whole audit pipeline works without it) ----
# provider: none | anthropic | openai   (openai = any OpenAI-compatible endpoint, e.g. local Ollama/vLLM via LLM_BASE_URL)
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
# Optional cost tracking ($ per million tokens) for the observability page
LLM_INPUT_COST_PER_MTOK=0
LLM_OUTPUT_COST_PER_MTOK=0

# ---- Storage (defaults shown; SQLite for the MVP, PostgreSQL-compatible via SQLAlchemy URL) ----
# DATABASE_URL=sqlite:///./data/solvex.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/solvex

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
